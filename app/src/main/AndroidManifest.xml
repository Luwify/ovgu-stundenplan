<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only for scanning a friend's QR code; asked for when scanning. Frames are never stored or sent. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Only for the updater: the version list (updates.json) and APKs of the app's own release repo
         (core/update/UpdateSource). No other connections, no identifiers, no analytics. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Installing a verified update through PackageInstaller; the user confirms each install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".StundenplanApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/launcher_label"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:supportsRtl="true"
        android:theme="@style/Theme.StundenplanMD">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" an .ics file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
                <data android:mimeType="application/ics" />
            </intent-filter>
            <!-- A friend's shared plan (own type), and files labeled octet-stream (many file managers and messengers
                 send .ics and .stundenplan files like that): the content decides (VCALENDAR or SPMD). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.luwify.stundenplan" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- Share an .ics file or a friend's plan to the app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="text/x-vcalendar" />
                <data android:mimeType="application/ics" />
                <data android:mimeType="application/vnd.luwify.stundenplan" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>
        <!-- Result of an update install session (PackageInstaller). -->
        <receiver
            android:name=".data.update.InstallResultReceiver"
            android:exported="false" />
        <!-- My plan as a file for the share sheet (cache/share only). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>
