<?xml version="1.0" encoding="utf-8"?>
<!-- Material dialog enter: fade in with a slight scale from 92 %, standard decelerate (see ui/Motion.kt). -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="150" android:interpolator="@android:interpolator/decelerate_cubic" />
    <scale
        android:fromXScale="0.92" android:toXScale="1" android:fromYScale="0.92" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="250"
        android:interpolator="@android:interpolator/decelerate_cubic" />
</set>
